pipeline {
    agent any
    
    environment {
        dockerImage = 'supplychaintracking:3.5.0'
        dockerUsername = 'nasreddine007'
        dockerPassword = 'PwdDockerToken'
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'main', credentialsId: 'token_github', url: 'https://github.com/nasreddineelmadhkour/SupplyChainTracking.git'
                }
            }
        }
        stage('Clean & Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('Build') {
                    steps {
                        script {
                                sh 'mvn clean install -DskipTests'
                        }
                    }
        }
        stage('Sonar-Analysis') {
                    steps {
                        script {
                                sh "mvn clean verify sonar:sonar \
                                -Dsonar.projectKey=SupplyChainTracking \
                                -Dsonar.projectName='SupplyChainTracking' \
                                -Dsonar.host.url=http://172.17.20.244:9000 \
                                -Dsonar.token=sqp_d335aedf256e888c9c9decf16073ad8d0eaf5625 "
                        }
                    }
        }
        stage('Junit & Mock') {
            steps {
                sh 'mvn test'
            }
        }
        stage('Deploy to Nexus') {
                    steps {
                        script {
                            sh 'mvn deploy -DskipTests'
                        }
                    }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker  login -u $dockerUsername -p $dockerPassword"
                    sh "docker build -t $dockerUsername/$dockerImage ."
                }
            }
        }
        
        
        stage('Push Docker Image') {
            steps {
                script {

                    sh "docker push $dockerUsername/$dockerImage "

                }
            }
        }
         
        stage('Deploy with Docker Compose') {
            steps {
                script {
                    sh "docker login -u $dockerUsername -p $dockerPassword"
                    sh "docker compose down"
                    sh "docker compose -f docker-compose.yml up -d"
                    sh "docker compose logs"
                    sh "docker logout"
                }
            }
        }
        
        
    }
}
